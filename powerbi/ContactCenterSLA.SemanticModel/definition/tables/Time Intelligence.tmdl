/// Calculation group: the same measure for the current period, month/year to date and against last year.
table 'Time Intelligence'
	lineageTag: f14c1ede-0c2b-4fe0-9792-ce8208267116

	calculationGroup
		precedence: 10

		calculationItem Current = SELECTEDMEASURE ()

		calculationItem MTD = CALCULATE ( SELECTEDMEASURE (), DATESMTD ( 'Date'[Date] ) )

		calculationItem YTD = CALCULATE ( SELECTEDMEASURE (), DATESYTD ( 'Date'[Date] ) )

		calculationItem PY = CALCULATE ( SELECTEDMEASURE (), SAMEPERIODLASTYEAR ( 'Date'[Date] ) )

		calculationItem 'YoY Δ' =
				VAR CurrentValue = SELECTEDMEASURE ()
				VAR PreviousValue = CALCULATE ( SELECTEDMEASURE (), SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
				RETURN IF ( NOT ISBLANK ( CurrentValue ) && NOT ISBLANK ( PreviousValue ), CurrentValue - PreviousValue )

		calculationItem 'YoY %' =
				VAR CurrentValue = SELECTEDMEASURE ()
				VAR PreviousValue = CALCULATE ( SELECTEDMEASURE (), SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
				RETURN IF ( NOT ISBLANK ( CurrentValue ) && NOT ISBLANK ( PreviousValue ), DIVIDE ( CurrentValue - PreviousValue, PreviousValue ) )

			formatStringDefinition = "+0.0%;-0.0%;0.0%"

	column Period
		dataType: string
		lineageTag: b100942b-a397-4f41-ad52-138172ea86a9
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

	column Ordinal
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 85a6ec0f-d1ac-48be-aac4-f7750bfb4eab
		summarizeBy: sum
		sourceColumn: Ordinal

	partition 'Time Intelligence' = calculationGroup

