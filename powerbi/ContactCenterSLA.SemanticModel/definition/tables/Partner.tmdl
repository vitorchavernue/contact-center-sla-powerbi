/// BPO partners that answer the bank's customers.
table Partner
	lineageTag: b891ee46-6ef3-48af-9bf0-b6cf4cbc66d5

	column 'Partner Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 74dfd332-7620-4cb3-82ff-6607c7571b31
